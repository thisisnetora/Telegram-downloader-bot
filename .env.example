# ====== اجباری ======
BOT_TOKEN=123456789:AAExample-Token-From-BotFather

# ====== پنل مدیریت ======
# آیدی عددی ادمین‌ها با کاما — از @userinfobot بگیر
ADMIN_IDS=

# ====== جوین اجباری (اختیاری) ======
FORCE_JOIN_CHANNEL=
FORCE_JOIN_LINK=

# ====== کوکی — برای یوتیوب تقریباً حتمیه ======
# محتوای فایل کوکی به‌صورت base64 (ضدخرابکاری)...
COOKIES_B64=
# ...یا متن خام کوکی (Netscape format)
COOKIES_CONTENT=

# ====== تنظیمات دیگر (اختیاری) ======
BOT_BRAND=Netora
MAX_FILE_MB=49
BOT_API_URL=
# با docker-compose این دو روی volume دائمی (/data) ست می‌شن
DATA_FILE=bot_data.json
COOKIES_FILE=cookies.txt
